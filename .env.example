# Template for local credentials and deploy parameters. Copy it to .env and fill in values. .env is gitignored, so plaintext keys stay out of git.
#
#   ./scripts/init-env.sh     # copy to .env, and generate random values for the empty items in the "Secrets" section below
#
# Both ways of using it read the same file:
#   - docker compose up -d: compose reads .env at the repo root automatically and uses it to fill the ${...} in docker-compose.yml;
#   - ./dev.sh: the script runs `source .env` (executed as a shell script), so **values with spaces must be quoted**.
#
# The Ark API Key is **not configured here**: after logging in, fill it in under "Ark credentials" in workspace settings (or fill an account-level one
# that workspaces can reuse directly). ARK_API_KEY below is only for command-line tools like cmd/selfhosted-bootstrap.

# ---------------------------------------------------------------------------
# External access and ports (docker compose)
# ---------------------------------------------------------------------------

# compose project name, defaults to the directory name. If the same machine already has a project with the same name (say another repo also called ama)
# you must change it, otherwise compose treats the other project's containers as its own and rebuilds them.
COMPOSE_PROJECT_NAME=

# Ports mapped on the host, default 9999. amad and s3 listen on all interfaces (the browser needs to reach them);
# PG / Redis bind only 127.0.0.1 (only for dev.sh on this machine); their ports can be changed with the two items below.
AMA_PORT=
AMA_PG_PORT=
AMA_REDIS_PORT=

# The address the browser uses. When it starts with https:// the Cookie gets Secure; with OIDC on it is also used to build the callback URL.
# When empty, compose defaults to http://localhost:9999.
AMA_PUBLIC_URL=

# Page origins allowed to open the terminal WebSocket, comma-separated. Usually just AMA_PUBLIC_URL itself.
AMA_TERMINAL_WS_ORIGINS=

# ---------------------------------------------------------------------------
# Object storage (RustFS in docker compose; empty uses defaults)
# ---------------------------------------------------------------------------
#
# File bytes (attachments, skill files, personal files) are all in object storage; PG only stores metadata.

# Port mapped on the host, default 19000. **This is what the browser hits when downloading personal files.**
AMA_S3_PORT=
# Object storage address the browser can open, default http://localhost:${AMA_S3_PORT}.
# If the browser is not on this machine, change it to http://<this machine's IP or domain>:19000. The presigned link has Host signed into it,
# so the symptom of getting this wrong is "download gives 403 / will not open".
AMA_S3_PUBLIC_ENDPOINT=
# Bucket name, default ama (amad creates it on start if missing).
AMA_S3_BUCKET=

# ---------------------------------------------------------------------------
# Secrets (required; docker compose errors out and will not start if any one is missing)
# ---------------------------------------------------------------------------
#
# ./scripts/init-env.sh fills random values into the items here that are **empty**, and leaves filled ones alone.
# ⚠️ The PG password only takes effect when the data volume is first created: changing it after the volume exists does not change the password in the database.

# PostgreSQL password (compose uses it to create the database, and also passes it to amad).
AMA_PG_PASSWORD=
# Redis password (compose uses it to start redis --requirepass, and also passes it to amad).
AMA_REDIS_PASSWORD=
# Access keys for the RustFS object storage (compose uses them to start RustFS, and also passes them to amad).
AMA_S3_ACCESS_KEY=
AMA_S3_SECRET_KEY=

# Master key that encrypts users' Ark credentials, 32 bytes in base64. ⚠️ If you change it, already encrypted credentials can no longer be decrypted.
ARK_SECRET_KEY=

# Key used to derive "the managed API Key used by the ama command inside containers".
AMA_AUTH_MANAGED_KEY_SECRET=

# ---------------------------------------------------------------------------
# Login (empty uses the value from the config file)
# ---------------------------------------------------------------------------

# Local accounts (email + password): true / false. The first registered account automatically becomes the platform admin;
# after that, whether self sign-up is allowed is decided by AMA_AUTH_LOCAL_ALLOW_SIGNUP (not allowed by default).
AMA_AUTH_LOCAL_ENABLED=
AMA_AUTH_LOCAL_ALLOW_SIGNUP=

# OIDC: enabled only when both issuer and client id are filled. The redirect_uri registered on the IdP is
# <AMA_PUBLIC_URL>/api/auth/oidc/callback.
AMA_AUTH_OIDC_ISSUER=
AMA_AUTH_OIDC_CLIENT_ID=
AMA_AUTH_OIDC_CLIENT_SECRET=
AMA_AUTH_OIDC_DISPLAY_NAME=

# Platform admin emails, comma-separated.
AMA_AUTH_ADMINS=

# GitHub login (OAuth device flow; needs only a client id, no secret). ENABLED=true turns it on.
# An empty CLIENT_ID defaults to the public client id of GitHub CLI (the consent page shows "GitHub CLI", and GitHub may revoke it);
# for a real deployment, create one under GitHub → Settings → Developer settings → OAuth Apps, check
# "Enable Device Flow", and fill it in here.
# ⚠️ When all three ALLOWED_* are empty no GitHub account can log in; matching any one of them lets the user in. Lists are comma-separated.
# PROXY is only used to reach github.com / api.github.com (from inside a container the host's proxy is usually http://172.17.0.1:<port>).
AMA_AUTH_GITHUB_ENABLED=
AMA_AUTH_GITHUB_CLIENT_ID=
AMA_AUTH_GITHUB_SCOPES=
AMA_AUTH_GITHUB_DISPLAY_NAME=
AMA_AUTH_GITHUB_PROXY=
AMA_AUTH_GITHUB_ALLOWED_USERS=
AMA_AUTH_GITHUB_ALLOWED_EMAIL_DOMAINS=
AMA_AUTH_GITHUB_ALLOWED_ORGS=

# ---------------------------------------------------------------------------
# Docker executor (docker compose; empty uses defaults)
# ---------------------------------------------------------------------------

# Session container image, default ama-sandbox:latest (compose builds it from sandbox-image/).
AMA_DOCKER_IMAGE=
# Network the session containers join, default ama-net.
AMA_DOCKER_NETWORK=
# After a conversation turn goes idle: pause (default) / stop / none.
AMA_DOCKER_IDLE_ACTION=
# Resource limits per session container, like 2g / 1.5. Empty means no limit.
AMA_DOCKER_MEMORY=
AMA_DOCKER_CPUS=

# ---------------------------------------------------------------------------
# Ark (only for command-line tools; see the file header)
# ---------------------------------------------------------------------------

ARK_API_KEY=
ARK_ENVIRONMENT_ID=

# ---------------------------------------------------------------------------
# Fixed API Key channel (e2e / CI / scripts)
# ---------------------------------------------------------------------------
#
# Lets callers that "are not people" bypass login. **It is enabled only when both Key and Email are non-empty**; configuring only one
# silently does nothing (endpoints still return 401).
#
# Three ways to send it (`credentialFrom` in `server/auth/handler.go`, by priority):
#   Authorization: Bearer <key>     normal requests
#   Cookie: ama_session=<key>       browsers (including SSE; EventSource cannot set custom headers)
#   ?api_key=<key>                  non-browser SSE clients
#
# ⚠️ It is a **permanent** key that bypasses login; configured in the wrong place it is a backdoor. Do not configure it in production.
# Note that docker-compose.yml does not pass it to the amad container by default; these items are mainly for ./dev.sh.
AMA_API_KEY=
# The identity behind this key (the email is the user's unique ID); workspace member permissions are checked against it.
AMA_API_KEY_EMAIL=
# Display name, optional. Must be quoted if it contains spaces.
AMA_API_KEY_NAME=
